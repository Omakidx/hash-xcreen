# Loads the host ruleset that keeps desktops away from the host and from the networks behind it
# (docs/architecture.md 4.2, docs/ipc.md 6.4 step 3). The ruleset is generated by hx-provision and
# written by hx-privd's SetupHost to /etc/hx/host-firewall.nft; this oneshot loads it at boot,
# before Incus can start a desktop. The rules act only on packets that enter from our bridge, so
# loading them before the bridge exists is harmless.

[Unit]
Description=hash-xcreen host firewall (isolates desktops from the host)
Documentation=https://github.com/Omakidx/hash-xcreen/blob/main/docs/architecture.md
DefaultDependencies=no
After=local-fs.target
Before=incus.service network-pre.target
ConditionPathExists=/etc/hx/host-firewall.nft

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/hx/host-firewall.nft

[Install]
WantedBy=multi-user.target
