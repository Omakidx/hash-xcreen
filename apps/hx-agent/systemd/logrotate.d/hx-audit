# Rotation of hx-privd's audit log (docs/ipc.md section 8). privd keeps the file open, so it is told
# to reopen it with SIGHUP after the rotation (it also rotates itself to audit.log.1 at 64 MiB, so
# the file stays bounded even where logrotate does not run).
/var/log/hx/audit.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    create 0640 root root
    postrotate
        systemctl kill --kill-whom=main --signal=HUP hx-privd.service >/dev/null 2>&1 || true
    endscript
}
